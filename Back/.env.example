# Crie Back/.env a partir deste modelo. Não envie o .env para o GitHub.
DB_HOST=SEU_HOST_NEON_SEM_HTTPS
DB_PORT=5432
DB_NAME=SiteTransportadora
DB_USER=SEU_USUARIO_DO_BANCO
DB_PASSWORD=COLOQUE_SUA_SENHA_APENAS_NO_ENV_LOCAL
DB_SSL=true
PORT=3000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_OU_MAIS
# Recuperação real requer serviço Resend e domínio de envio verificado:
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_FRONTEND_URL=http://localhost:5173
